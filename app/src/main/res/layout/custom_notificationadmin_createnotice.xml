<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/subheadingBottomMargin"
            android:text="Title"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/subheadingSize" />

        <EditText
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/name"
            android:drawableLeft="@drawable/name"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:importantForAutofill="auto"
            android:inputType="textCapWords"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/edt_textSize" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1px"
            android:layout_marginBottom="@dimen/fieldBottomMargin"
            android:background="@color/colorAccent" />

        <!--        -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/subheadingBottomMargin"
            android:text="Message"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/subheadingSize" />

        <EditText
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/qualification"
            android:drawableLeft="@drawable/qualification"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:importantForAutofill="auto"
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/edt_textSize" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1px"
            android:layout_marginBottom="@dimen/fieldBottomMargin"
            android:background="@color/colorAccent" />

        <!--        -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/subheadingBottomMargin"
            android:text="Link"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/subheadingSize" />

        <EditText
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/qualification"
            android:drawableLeft="@drawable/qualification"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:importantForAutofill="auto"
            android:inputType="textLongMessage"
            android:padding="10dp"
            android:singleLine="true"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/edt_textSize" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1px"
            android:layout_marginBottom="@dimen/fieldBottomMargin"
            android:background="@color/colorAccent" />

        ////

        ////

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/subheadingBottomMargin"
                    android:text="Audience Category"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/subheadingSize" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/blood"
                        android:drawableLeft="@drawable/blood"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAutofill="auto"
                        android:inputType="date"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/edt_textSize" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spn_aud_cat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawSelectorOnTop="true"
                        android:padding="8dp"
                        android:popupBackground="@color/colorWhite" />

                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1px"
                    android:layout_marginBottom="@dimen/fieldBottomMargin"
                    android:background="@color/colorAccent" />
                ////

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/subheadingBottomMargin"
                    android:text="Sub Category"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/subheadingSize" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/blood"
                        android:drawableLeft="@drawable/blood"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAutofill="auto"
                        android:inputType="date"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/edt_textSize" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/spn_aud_subcat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawSelectorOnTop="true"
                        android:padding="8dp"
                        android:popupBackground="@color/colorWhite" />

                </LinearLayout>

                <View
                    android:layout_width="fill_parent"
                    android:layout_height="1px"
                    android:layout_marginBottom="@dimen/fieldBottomMargin"
                    android:background="@color/colorAccent" />
                ////

            </LinearLayout>

        </LinearLayout>

        ////


    </LinearLayout>
</LinearLayout>