<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CalendarView
                android:id="@+id/attendance_calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorWhite"
                android:orientation="vertical"
                android:paddingLeft="@dimen/activity_margin"
                android:paddingRight="@dimen/activity_margin"
                android:paddingBottom="@dimen/activity_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingBottom="@dimen/subheadingSize">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Monthly Average"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/headingSize" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/activity_marginSmall"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Present"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/subheadingSize" />

                        <LinearLayout
                            android:layout_width="@dimen/boxSize"
                            android:layout_height="@dimen/boxSize"
                            android:layout_marginBottom="4dp"
                            android:background="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/attendance_monthStatsPresentPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/subheadingSize" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/activity_marginSmall"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Absent"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/subheadingSize" />

                        <LinearLayout
                            android:layout_width="@dimen/boxSize"
                            android:layout_height="@dimen/boxSize"
                            android:layout_marginBottom="4dp"
                            android:background="@color/colorPrimaryDark" />

                        <TextView
                            android:id="@+id/attendance_monthStatsAbsentPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/subheadingSize" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/activity_marginSmall"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Late"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/subheadingSize" />

                        <LinearLayout
                            android:layout_width="@dimen/boxSize"
                            android:layout_height="@dimen/boxSize"
                            android:layout_marginBottom="4dp"
                            android:background="@color/colorOrange" />

                        <TextView
                            android:id="@+id/attendance_monthStatsLatePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/subheadingSize" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Leave"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/subheadingSize" />

                        <LinearLayout
                            android:layout_width="@dimen/boxSize"
                            android:layout_height="@dimen/boxSize"
                            android:layout_marginBottom="4dp"
                            android:background="@color/colorYellow" />

                        <TextView
                            android:id="@+id/attendance_monthStatsLeavePercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:textColor="@color/colorAccent"
                            android:textSize="@dimen/subheadingSize" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>