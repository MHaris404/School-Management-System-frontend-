<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/custom_notification"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@drawable/custom_notification_background"
    android:orientation="vertical"
    android:padding="@dimen/headingBottomMargin"
    app:layout_behavior="androidx.support.design.widget.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="600dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/subheadingSize"
            android:text="Notifications"
            android:textSize="@dimen/headingSize"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbarThumbVertical="@color/colorPrimary"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_notif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/subheadingSize">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/subheadingSize">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="fill_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Assigment"
                                    android:textColor="@color/colorPrimaryDark"
                                    android:textSize="@dimen/subheadingSize" />

                                <LinearLayout
                                    android:layout_width="fill_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginRight="@dimen/activity_marginsmallest"
                                        android:text="From:"
                                        android:textColor="@color/colorAccent"
                                        android:textSize="@dimen/subheadingSize" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Razia Nisar"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="@dimen/subheadingSize" />


                                </LinearLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top">

                                <Button
                                    android:id="@+id/btn_expandNotif"
                                    android:layout_width="45px"
                                    android:layout_height="45px"
                                    android:background="@drawable/iconarrowdown"
                                    android:backgroundTint="@color/colorPrimaryDark" />


                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/notif_message"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="@dimen/activity_marginsmallest"
                                android:text="Message:"
                                android:textColor="@color/colorAccent"
                                android:textSize="@dimen/subheadingSize" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="sdsadd dnkjadkjasd dj fef fewfew few fewfew f ewfew f ewffw   efew f ewfe f ewf wef ew fw ef d asd a"
                                android:textColor="@color/colorPrimary"
                                android:textSize="@dimen/subheadingSize" />

                        </LinearLayout>
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>

</LinearLayout>