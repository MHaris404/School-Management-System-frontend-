<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="left"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/subheadingBottomMargin"
            android:text="Package"
            android:textColor="@color/colorPrimaryDark"
            android:textSize="@dimen/subheadingSize" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/gender"
                android:drawableLeft="@drawable/gender"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="date"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spn_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawSelectorOnTop="true"
                android:entries="@array/spn_gender"
                android:padding="8dp"
                android:popupBackground="@color/colorWhite" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>