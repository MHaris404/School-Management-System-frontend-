<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="14dp"
            android:paddingRight="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/subheadingBottomMargin"
                        android:text="@string/first_name"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/subheadingSize" />

                    <EditText
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/name"
                        android:drawableLeft="@drawable/name"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAutofill="auto"
                        android:inputType="textCapWords"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/edt_textSize" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="1px"
                        android:layout_marginBottom="@dimen/fieldBottomMargin"
                        android:background="@color/colorAccent" />
                    ////

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/subheadingBottomMargin"
                        android:text="@string/last_name"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/subheadingSize" />

                    <EditText
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="4dp"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/name"
                        android:drawableLeft="@drawable/name"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAutofill="auto"
                        android:inputType="textCapWords"
                        android:padding="10dp"
                        android:singleLine="true"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/edt_textSize" />

                    <View
                        android:layout_width="fill_parent"
                        android:layout_height="1px"
                        android:layout_marginBottom="@dimen/fieldBottomMargin"
                        android:background="@color/colorAccent" />
                    ////

                </LinearLayout>

            </LinearLayout>
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/date_of_birth"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/calendar"
                android:drawableLeft="@drawable/calendar"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="date"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/class_grade_applying_for"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/grade"
                    android:drawableLeft="@drawable/grade"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="auto"
                    android:inputType="date"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/edt_textSize" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spn_grade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawSelectorOnTop="true"
                    android:entries="@array/spn_grade"
                    android:padding="8dp"
                    android:popupBackground="@color/colorWhite" />

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="Blood Group"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/blood"
                    android:drawableLeft="@drawable/blood"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="auto"
                    android:inputType="date"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/edt_textSize" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spn_bloodGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawSelectorOnTop="true"
                    android:entries="@array/spn_bloodGroup"
                    android:padding="8dp"
                    android:popupBackground="@color/colorWhite" />

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/student_address"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/address"
                android:drawableLeft="@drawable/address"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="textPostalAddress"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/contact_1"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/phone2"
                android:drawableLeft="@drawable/phone2"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="phone"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />

            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/email"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/email"
                android:drawableLeft="@drawable/email"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="textEmailAddress"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/religion"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/religion"
                android:drawableLeft="@drawable/religion"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/gender"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/gender"
                    android:drawableLeft="@drawable/gender"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="auto"
                    android:inputType="date"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/edt_textSize" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spn_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawSelectorOnTop="true"
                    android:entries="@array/spn_gender"
                    android:padding="8dp"
                    android:popupBackground="@color/colorWhite" />

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="Under Guardian Observation"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/guard"
                    android:drawableLeft="@drawable/guard"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="auto"
                    android:inputType="date"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/edt_textSize" />

                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Yes"
                    android:textColor="@color/colorPrimaryDark" />

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="Medical Condition"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/medical"
                android:drawableLeft="@drawable/medical"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="3px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/headingBottomMargin"
                android:text="@string/academic_history"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/headingSize" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/previous_institute_title"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/school"
                android:drawableLeft="@drawable/school"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="textCapWords"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="@string/previous_institute_contact"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <EditText
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/telephone"
                android:drawableLeft="@drawable/telephone"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:importantForAutofill="auto"
                android:inputType="phone"
                android:padding="10dp"
                android:singleLine="true"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/edt_textSize" />

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:text="Last Class/Grade"
                android:textColor="@color/colorPrimaryDark"
                android:textSize="@dimen/subheadingSize" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:drawableStart="@drawable/grade"
                    android:drawableLeft="@drawable/grade"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:importantForAutofill="auto"
                    android:inputType="date"
                    android:padding="10dp"
                    android:singleLine="true"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/edt_textSize" />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spn_gradeLast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawSelectorOnTop="true"
                    android:entries="@array/spn_grade"
                    android:padding="8dp"
                    android:popupBackground="@color/colorWhite" />

            </LinearLayout>

            <View
                android:layout_width="fill_parent"
                android:layout_height="1px"
                android:layout_marginBottom="@dimen/fieldBottomMargin"
                android:background="@color/colorAccent" />
            ////

            <Button
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/subheadingBottomMargin"
                android:background="@drawable/loginbutton_selector_blue"
                android:drawablePadding="0dp"
                android:padding="3dp"
                android:text="Submit Application"
                android:textColor="@color/colorWhite"
                android:textSize="17sp"
                android:textStyle="bold" />
            ////
        </LinearLayout>

    </ScrollView>
</LinearLayout>