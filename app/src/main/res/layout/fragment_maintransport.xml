<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <fragment
        android:id="@+id/transport_mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:padding="@dimen/activity_marginSmall"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Faizan's"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/headingSize" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="School Bus"
                    android:textColor="@color/colorWhite"
                    android:textSize="@dimen/headingSize"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </fragment>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_transportStreet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting Address - "
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/subheadingSize"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pickup Trip"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/subheadingSize" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_marginSmall">

            <ImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginRight="@dimen/activity_margin"
                android:src="@drawable/iconsbus"
                android:tint="@color/colorWhite" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="3sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bus - "
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07"
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="( "
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize" />

                    <TextView
                        android:id="@+id/txt_transport_routeDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/colorPrimaryDark"
                        android:textSize="@dimen/subheadingSize" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5sp"
                        android:layout_marginEnd="5sp"
                        android:text="away"
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" )"
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
        <!--                    -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/activity_marginSmall"
            android:layout_marginBottom="@dimen/activity_marginSmall"
            android:background="@color/colorAccent" />
        <!--                    -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginRight="@dimen/activity_margin"
                android:src="@drawable/icondriver"
                android:tint="@color/colorWhite" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="3sp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driver"
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saqlain Mushtaq"
                        android:textColor="@color/colorWhite"
                        android:textSize="@dimen/subheadingSize"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <Button
                android:id="@+id/btn_driverCall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/roundbutton_call"
                android:drawableEnd="@drawable/iconcall"
                android:drawableTint="@color/colorPrimaryDark"
                android:gravity="center_vertical" />

        </LinearLayout>

    </LinearLayout>


</LinearLayout>