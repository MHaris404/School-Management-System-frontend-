                        android:background="@drawable/loginbutton_selector_red"
                        android:drawablePadding="0dp"
                        android:padding="3dp"
                        android:text="Reject"
                        android:textColor="@color/colorWhite"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>
